# Maintainer: Eric Trantina
#
# The AUR package. It installs the binary attached to the GitHub release
# rather than building one, which for an alpha that moves this often is the
# difference between an update taking seconds and taking minutes.
#
# The -bin suffix is not optional: the AUR requires it of any package that
# installs pre-compiled binaries. `provides`/`conflicts` name the plain
# package so a source build can replace this one later without a fight.
#
# This file is usable as it stands: `makepkg -si` here installs the release
# it names, checksum and all. `make aur-bin` copies it to target/aur-bin,
# re-derives the checksum from what is actually published — which is how the
# one below is checked rather than trusted — and writes the .SRCINFO the AUR
# requires beside it.
pkgname=hyprcustard-bin
_pkgname=hyprcustard
_reponame=hyprcustard
pkgver=0.1.0
pkgrel=1
pkgdesc="A theming GUI for Hyprland, with HyprWindowShade shader support"
arch=('x86_64')
url="https://github.com/ManofJELLO/$_reponame"
license=('MIT')
# The binary is built in an Arch container against current Qt and glibc, so
# it needs those and nothing else; everything the app shells out to is
# optional and it says so in the UI when one is missing.
# The last three are named although the Qt packages pull them in anyway: the
# binary links libc, libstdc++ and libgcc_s directly, and a direct link
# belongs in depends rather than being inherited from something else's. They
# are their own packages now rather than gcc-libs, which still exists and is
# the wrong answer here.
depends=('qt6-base' 'qt6-declarative' 'glibc' 'libstdc++' 'libgcc' 'ffmpeg')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
optdepends=('hyprland: the compositor this configures'
            'hyprwindowshade: the shader plugin the Shaders, Layers and Plugin pages configure'
            'hyprpm: the Plugin page, which installs and reloads the plugin'
            'grim: the shader preview, which reads frames out of a nested compositor'
            'swaybg: your wallpaper behind the shader preview'
            'kitty: a terminal for the preview window and "Run in a terminal" (foot, alacritty, ghostty, wezterm, konsole or xterm will do as well)')
# Already stripped by the release profile, and there is no source to build a
# debug package from.
options=('!strip' '!debug')
source_x86_64=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$_pkgname-$pkgver-$CARCH.tar.gz")
# No hyprcustard release exists yet; `make aur-bin` fills this in from the
# published asset once one does.
sha256sums_x86_64=('SKIP')

package() {
    cd "$_pkgname-$pkgver-$CARCH"
    install -Dm755 "$_pkgname" "$pkgdir/usr/bin/$_pkgname"
    install -Dm755 custard-watch "$pkgdir/usr/bin/custard-watch"
    install -Dm644 "$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
